# Browser-visible configuration
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_API_VERSION=v25.0
VITE_APPLE_CLIENT_ID=
# Apple requires an exact registered HTTPS return URL (use a tunnel for local testing).
VITE_APPLE_REDIRECT_URI=https://your-domain.example
VITE_CLOUDINARY_CLOUD_NAME=
VITE_FIRST_ORDER_CODE=FIRST10
VITE_FIRST_ORDER_DISCOUNT=10
VITE_ENABLE_DEMO_AUTH=false

# Server-only configuration (never prefix secrets with VITE_)
MONGODB_URI=
MONGODB_DATABASE=gift_n_wrap
GOOGLE_CLIENT_ID=
# Facebook access tokens are verified on the server against this exact app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
# Sign in with Apple Services ID used as the ID-token audience.
APPLE_CLIENT_ID=
AUTH_NONCE_MINUTES=5

# Passwordless email verification. AUTH_EMAIL_FROM must be a sender/domain verified in Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM=Gift N Wrap <login@giftnwrapstudio.com>
AUTH_EMAIL_REPLY_TO=
EMAIL_OTP_SECRET=replace-with-a-separate-at-least-32-character-random-value
EMAIL_OTP_CHALLENGE_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5

# Optional legacy mobile verification. Set TWILIO_VERIFY_SERVICE_SID and exactly one credential option:
#   A) TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
#   B) TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET (preferred in production)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_AUTH_CHALLENGE_MINUTES=10
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=owner@example.com
CLIENT_ORIGINS=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
UPLOAD_SIGNATURES_PER_HOUR=20

WELCOME_COUPON_CODE=FIRST10
WELCOME_DISCOUNT_PERCENT=10
WELCOME_DISCOUNT_MAX=500
BULK_ORDER_THRESHOLD=10
FLAT_SHIPPING_FEE=99
FREE_SHIPPING_THRESHOLD=2000

# Local preview only. Keep both flags false in Vercel/production.
ALLOW_DEMO_AUTH=false
# Returned only when ALLOW_DEMO_AUTH=true outside production and Resend is not configured.
DEMO_EMAIL_OTP_CODE=246810
# Set true only to test order/admin writes locally without MongoDB Atlas.
ALLOW_MEMORY_WRITES=false
NODE_ENV=development
PORT=4000
